# Server ONLY. Configure these in the selected Vercel environment.
DATABASE_URL=
# Use websocket explicitly in a managed cloud environment without PostgreSQL TCP access.
# Vercel uses the default tcp transport. Both connect to the same real Neon database.
NEON_TRANSPORT=tcp
# Optional direct connection from Neon, used only when creating/updating tables.
DATABASE_URL_UNPOOLED=
# Optional alternative name for the same privileged setup connection.
MIGRATION_DATABASE_URL=
GEMINI_API_KEY=
# Verified on the pilot Google project; run test:live for your own target.
GEMINI_MODEL=gemini-3.5-flash-lite
SESSION_SECRET=
# Daily model token allowance for an instructor (extraction and question drafting).
STAFF_DAILY_TOKEN_BUDGET=300000
# Enable role selector only for synthetic demo records.
DEMO_MODE=true
# Preview/local sandbox defaults. For the explicitly authorized hosted pilot,
# set TILWA_ENV=pilot and PILOT_ACCESS_MODE=invite-only in Production.
# Hosted pilot requires an existing synthetic workspace code and cannot create accounts.
TILWA_ENV=preview
PILOT_ACCESS_MODE=
# Explicit local offline PostgreSQL development; must be false for Neon/Vercel.
LOCAL_DATABASE=0
PGLITE_PATH=.tilwa-private/db
# Optional integration and preview deployment
SIS_WEBHOOK_SECRET=
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_ORG_ID=
# To create isolated resources automatically (optional alternative to existing URLs)
NEON_API_KEY=
PROVISION_PREVIEW=0
VERCEL_TEAM_ID=
NEON_REGION=aws-us-east-1
PREVIEW_GEMINI_API_KEY=
# External SIS feed, disabled until configured
SIS_TENANT_ID=
# Opt-in real integration acceptance
LIVE_SMOKE=0
LIVE_BASE_URL=
LIVE_WORKSPACE_CODE=

# Deploy into an already-created Neon database and Vercel project.
# DATABASE_URL can be the owner URL for initial setup; the script creates a restricted runtime login.
DEPLOY_EXISTING=0
VERCEL_PROJECT_NAME=tilwa
VERCEL_TEAM_SLUG=mohamedtarek750s-projects
