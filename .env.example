# Server ONLY. Set these in local secret settings and Vercel Preview.
DATABASE_URL=
MIGRATION_DATABASE_URL=
GEMINI_API_KEY=
# Candidate stable model; confirm availability with your Google project using test:live.
GEMINI_MODEL=gemini-2.5-flash
SESSION_SECRET=
# Enable role selector ONLY on an isolated synthetic preview/sandbox.
DEMO_MODE=true
# Explicit local offline PostgreSQL development; must be false for Neon/Vercel.
LOCAL_DATABASE=0
PGLITE_PATH=.tilwa-private/db
# Optional integration and preview deployment
SIS_WEBHOOK_SECRET=
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_ORG_ID=
# To create isolated resources automatically (optional alternative to existing URLs)
NEON_API_KEY=
PROVISION_PREVIEW=0
VERCEL_TEAM_ID=
NEON_REGION=aws-us-east-1
PREVIEW_GEMINI_API_KEY=
# External SIS feed, disabled until configured
SIS_TENANT_ID=
# Opt-in real integration acceptance
LIVE_SMOKE=0
LIVE_BASE_URL=
LIVE_WORKSPACE_CODE=
