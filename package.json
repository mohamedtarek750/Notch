{
  "name": "tilwa",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:live": "tsx scripts/live-smoke.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "import:pack": "tsx scripts/import.ts",
    "dev:local": "tsx scripts/dev-local.ts",
    "test:unit": "vitest run",
    "provision:preview": "tsx scripts/provision-preview.ts",
    "deploy:preview": "vercel deploy --yes",
    "format": "prettier --write src scripts tests *.ts README.md docs/*.md",
    "test:production": "tsx scripts/check-production.ts",
    "deploy:existing": "tsx scripts/deploy-existing.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@google/genai": "^3.2.0",
    "@neondatabase/serverless": "^1.2.0",
    "fflate": "^0.8.3",
    "https-proxy-agent": "^9.1.0",
    "jose": "^6.2.17",
    "lucide-react": "^1.72.0",
    "next": "^16.4.6",
    "pdfjs-dist": "^6.5.438",
    "pg": "^8.23.1",
    "proxy-from-env": "^2.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/proxy-from-env": "^1.0.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vercel": "^65.14.0",
    "vitest": "^5.1.0"
  },
  "type": "module"
}
